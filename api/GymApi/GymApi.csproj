<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GymApi</RootNamespace>
    <!-- Secretos de desarrollo (dotnet user-secrets): clave de la API de IA, etc. -->
    <UserSecretsId>app-gimnasio-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- 10.0.* toma el último parche de .NET 10 disponible al restaurar -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <!-- Fija una versión corregida de esta dependencia de Microsoft.Data.SqlClient (avisos NU1902/NU1903) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
  </ItemGroup>

</Project>
